# Vercel Postgres Pooled Connection (PgBouncer)
POSTGRES_PRISMA_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15&sslmode=require"

# Vercel Postgres Direct Connection (Required for Prisma Migrations)
POSTGRES_URL_NON_POOLING="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"

# JWT Signing Secret (Minimum 32 characters; generate via: openssl rand -base64 32)
JWT_SECRET="replace-with-at-least-32-character-cryptographic-secret-key"

